---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { getTranslation, supportedLocales } from '../../i18n/utils';
import { ui } from '../../i18n/index';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const t = (key: keyof typeof ui.en) => getTranslation(locale, key);

const titles = {
  en: 'BitLoader - USB Boot Drive Creator for macOS',
  'zh-Hans': 'BitLoader - macOS USB 启动盘制作工具',
  'zh-Hant': 'BitLoader - macOS USB 開機碟製作工具',
  ja: 'BitLoader - macOS 用 USB ブートドライブ作成ツール',
  fr: 'BitLoader - Créateur de clé USB bootable pour macOS',
  de: 'BitLoader - USB-Boot-Laufwerk-Ersteller für macOS',
  es: 'BitLoader - Creador de unidades USB de arranque para macOS',
  ko: 'BitLoader - macOS 용 USB 부팅 드라이브 제작 도구',
  'pt-BR': 'BitLoader - Criador de Drive USB Bootável para macOS',
  ru: 'BitLoader - Создание загрузочных USB-накопителей для macOS',
  it: 'BitLoader - Creatore di unità USB avviabili per macOS',
  pl: 'BitLoader - Twórca bootowalnych napędów USB dla macOS',
  nl: 'BitLoader - Opstartbare USB-stick maker voor macOS',
};

const descriptions = {
  en: 'The easiest way to create bootable USB drives on macOS. Support for ISO, IMG, DMG and compressed formats.',
  'zh-Hans': '在 macOS 上制作可启动 USB 驱动器的最简单方法。支持 ISO、IMG、DMG 和压缩格式。',
  'zh-Hant': '在 macOS 上製作可開機 USB 隨身碟的最簡單方法。支援 ISO、IMG、DMG 和壓縮格式。',
  ja: 'macOS でブータブル USB ドライブを作成する最も簡単な方法。ISO、IMG、DMG、圧縮形式をサポート。',
  fr: 'La façon la plus simple de créer des clés USB bootables sur macOS. Support des formats ISO, IMG, DMG et compressés.',
  de: 'Der einfachste Weg, bootfähige USB-Laufwerke unter macOS zu erstellen. Unterstützung für ISO, IMG, DMG und komprimierte Formate.',
  es: 'La forma más fácil de crear unidades USB de arranque en macOS. Soporte para ISO, IMG, DMG y formatos comprimidos.',
  ko: 'macOS 에서 부팅 가능 USB 드라이브를 만드는 가장 쉬운 방법. ISO, IMG, DMG 및 압축 형식을 지원합니다.',
  'pt-BR': 'A maneira mais fácil de criar drives USB bootáveis no macOS. Suporte para ISO, IMG, DMG e formatos compactados.',
  ru: 'Самый простой способ создания загрузочных USB-накопителей в macOS. Поддержка ISO, IMG, DMG и сжатых форматов.',
  it: 'Il modo più semplice per creare unità USB avviabili su macOS. Supporto per ISO, IMG, DMG e formati compressi.',
  pl: 'Najłatwiejszy sposób na tworzenie bootowalnych napędów USB w macOS. Wsparcie dla ISO, IMG, DMG i formatów skompresowanych.',
  nl: 'De makkelijkste manier om opstartbare USB-sticks te maken op macOS. Ondersteuning voor ISO, IMG, DMG en gecomprimeerde formaten.',
};
---

<BaseLayout 
  title={titles[locale]} 
  description={descriptions[locale]} 
  locale={locale}
>
  <HomeContent locale={locale} t={t} />
</BaseLayout>
