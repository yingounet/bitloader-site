            <div>
              <div class="text-5xl font-bold text-gradient mb-2">100%</div>
              <div class="text-gray-400">Open Source</div>
            </div>
            <div>
              <div class="text-5xl font-bold text-gradient mb-2">Free</div>
              <div class="text-gray-400">Forever</div>
            </div>
            <div>
              <div class="text-5xl font-bold text-gradient mb-2">macOS</div>
              <div class="text-gray-400">13.0+</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Download Section -->
    <section id="download" class="py-32 relative overflow-hidden">
      <!-- Background effects -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/10 rounded-full blur-3xl"></div>
      
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
