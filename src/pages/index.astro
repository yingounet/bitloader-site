---
// Root index - renders English content (default locale)
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { getTranslation } from '../i18n/utils';
import { ui } from '../i18n/index';

const locale: 'en' = 'en';
const t = (key: keyof typeof ui.en) => getTranslation(locale, key);
---

<BaseLayout 
  title="BitLoader - USB Boot Drive Creator for macOS" 
  description="The easiest way to create bootable USB drives on macOS. Support for ISO, IMG, DMG and compressed formats." 
  locale={locale}
>
  <HomeContent locale={locale} t={t} />
</BaseLayout>
