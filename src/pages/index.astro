          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-sm text-gray-300">Open Source & Free</span>
        </div>
        
        <!-- Main heading -->
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold text-white mb-6 slide-up">
          Create Bootable USB<br/>
          <span class="text-gradient">In Minutes</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-10 slide-up" style="animation-delay: 0.2s">
          The easiest way to write system images to USB drives on macOS. 
          No command line required.
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 slide-up" style="animation-delay: 0.4s">
          <a href="#download" class="btn-primary px-8 py-4 rounded-full font-semibold text-white text-lg flex items-center space-x-2 pulse-glow">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>Download for macOS</span>
