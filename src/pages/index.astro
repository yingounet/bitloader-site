              <!-- Window header -->
              <div class="bg-slate-800 px-4 py-3 flex items-center space-x-2">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                <span class="ml-4 text-sm text-gray-400">BitLoader</span>
              </div>
              <!-- App content mockup -->
              <div class="p-8">
                <div class="grid grid-cols-2 gap-6 mb-6">
                  <div class="glass rounded-xl p-4">
                    <div class="text-sm text-gray-400 mb-2">Image File</div>
                    <div class="h-12 bg-slate-800 rounded-lg flex items-center justify-center">
                      <span class="text-gray-500">ubuntu-24.04.iso</span>
                    </div>
                  </div>
                  <div class="glass rounded-xl p-4">
                    <div class="text-sm text-gray-400 mb-2">USB Device</div>
                    <div class="h-12 bg-slate-800 rounded-lg flex items-center justify-center">
                      <span class="text-gray-500">SanDisk 32GB</span>
                    </div>
                  </div>
                </div>
                <!-- Progress bar -->
                <div class="glass rounded-xl p-4">
                  <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-400">Writing...</span>
                    <span class="text-blue-400">75%</span>
                  </div>
                  <div class="h-3 bg-slate-800 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full progress-animate" style="width: 75%"></div>
                  </div>
                  <div class="flex justify-between text-xs text-gray-500 mt-2">
                    <span>2.4 MB/s</span>
                    <span>~2 min remaining</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Decorative elements -->
          <div class="absolute -top-4 -right-4 w-20 h-20 glass rounded-xl flex items-center justify-center sparkle">
            <span class="text-3xl">✨</span>
          </div>
          <div class="absolute -bottom-4 -left-4 w-16 h-16 glass rounded-xl flex items-center justify-center sparkle" style="animation-delay: 0.5s">
            <span class="text-2xl">🚀</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-32 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-20">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Powerful Features, <span class="text-gradient">Simple Interface</span>
          </h2>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            Everything you need to create bootable USB drives, nothing you don't.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature, index) => (
            <div class="feature-card glass rounded-2xl p-8 border border-white/5">
              <div class="text-5xl mb-6">{feature.icon}</div>
              <h3 class="text-xl font-semibold text-white mb-3">{feature.title}</h3>
              <p class="text-gray-400 leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="py-32 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-900/10 to-transparent"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-20">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            How It <span class="text-gradient">Works</span>
          </h2>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            Four simple steps to your bootable USB drive
          </p>
        </div>
        
        <div class="grid md:grid-cols-4 gap-8">
          {steps.map((step, index) => (
            <div class="relative">
              {index < steps.length - 1 && (
                <div class="hidden md:block absolute top-12 left-1/2 w-full h-0.5 bg-gradient-to-r from-blue-500/50 to-cyan-500/50"></div>
              )}
              <div class="relative text-center">
                <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center glow-blue">
                  <span class="text-3xl font-bold text-white">{step.number}</span>
                </div>
                <h3 class="text-xl font-semibold text-white mb-2">{step.title}</h3>
                <p class="text-gray-400">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-20 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass rounded-3xl p-12 border border-white/10">
