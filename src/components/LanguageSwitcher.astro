---
import { languages } from '../i18n/index';
import { getPathWithLocale, supportedLocales } from '../i18n/utils';

export interface Props {
  currentLocale: 'en' | 'zh-Hans' | 'zh-Hant' | 'ja' | 'fr' | 'de' | 'es' | 'ko' | 'pt-BR' | 'ru' | 'it' | 'pl' | 'nl';
}

const { currentLocale } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="language-switcher relative">
  <details class="language-dropdown">
    <summary class="language-button">
      <span class="current-lang">{languages[currentLocale]}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="language-menu">
      {supportedLocales.map((locale) => (
        <a
          href={getPathWithLocale(currentPath, locale)}
          class="language-item"
          class:list={{ active: locale === currentLocale }}
        >
          {languages[locale]}
        </a>
      ))}
    </div>
  </details>
</div>

<style>
  .language-switcher {
    display: inline-block;
  }
  
  .language-dropdown {
    position: relative;
    list-style: none;
  }
  
  .language-dropdown summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.875rem;
    color: #fff;
  }
  
  .language-dropdown summary:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  
  .language-dropdown summary::-webkit-details-marker {
    display: none;
  }
  
  .language-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 160px;
    background: rgba(30, 41, 59, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 0.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    z-index: 100;
    opacity: 0;
    transform: translateY(-10px);
    animation: menuFadeIn 0.2s ease forwards;
  }
  
  @keyframes menuFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .language-item {
    display: block;
    padding: 0.625rem 1rem;
    color: #e5e7eb;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }
  
  .language-item:hover {
    background: rgba(59, 130, 246, 0.2);
    color: #fff;
  }
  
  .language-item.active {
    background: rgba(59, 130, 246, 0.3);
    color: #60a5fa;
  }
</style>
