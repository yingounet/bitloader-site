---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  locale: 'en' | 'zh-Hans' | 'zh-Hant' | 'ja' | 'fr' | 'de' | 'es' | 'ko' | 'pt-BR' | 'ru' | 'it' | 'pl' | 'nl';
  t: (key: string) => string;
}

const { locale, t } = Astro.props;

const features = [
  {
    icon: '📦',
    title: t('feature1Title'),
    description: t('feature1Desc')
  },
  {
    icon: '🗜️',
    title: t('feature2Title'),
    description: t('feature2Desc')
  },
  {
    icon: '🔒',
    title: t('feature3Title'),
    description: t('feature3Desc')
  },
  {
    icon: '⚡',
    title: t('feature4Title'),
    description: t('feature4Desc')
  },
  {
    icon: '✅',
    title: t('feature5Title'),
    description: t('feature5Desc')
  },
  {
    icon: '🎯',
    title: t('feature6Title'),
    description: t('feature6Desc')
  }
];

const steps = [
  { number: '01', title: t('step1Title'), description: t('step1Desc') },
  { number: '02', title: t('step2Title'), description: t('step2Desc') },
  { number: '03', title: t('step3Title'), description: t('step3Desc') },
  { number: '04', title: t('step4Title'), description: t('step4Desc') },
];
---

<div>
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 glass-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center glow-blue">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-white">BitLoader</span>
        </div>
        <div class="hidden md:flex items-center space-x-8">
          <a href="#features" class="text-gray-300 hover:text-white transition-colors">{t('navFeatures')}</a>
          <a href="#how-it-works" class="text-gray-300 hover:text-white transition-colors">{t('navHowItWorks')}</a>
          <a href="#download" class="text-gray-300 hover:text-white transition-colors">{t('navDownload')}</a>
          <a href="https://github.com/yingounet/BitLoader" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors flex items-center space-x-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            <span>{t('navGitHub')}</span>
          </a>
        </div>
        <div class="flex items-center gap-3">
          <LanguageSwitcher currentLocale={locale} />
          <a href="#download" class="btn-primary px-6 py-2 rounded-full font-semibold text-white">
            {t('navDownload')}
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
    <!-- Background effects -->
    <div class="absolute inset-0 grid-pattern opacity-30"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl float"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl float-delayed"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center space-x-2 glass px-4 py-2 rounded-full mb-8 scale-in">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        <span class="text-sm text-gray-300">{t('heroBadge')}</span>
      </div>

      <!-- Main heading -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-extrabold text-white mb-6 slide-up">
        {t('heroTitle1')}<br/>
        <span class="text-gradient">{t('heroTitle2')}</span>
      </h1>

      <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-10 slide-up" style="animation-delay: 0.2s">
        {t('heroDescription')}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 slide-up" style="animation-delay: 0.4s">
        <a href="#download" class="btn-primary px-8 py-4 rounded-full font-semibold text-white text-lg flex items-center space-x-2 pulse-glow">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>{t('heroDownload')}</span>
        </a>
        <a href="https://github.com/yingounet/BitLoader" target="_blank" rel="noopener noreferrer" class="glass px-8 py-4 rounded-full font-semibold text-white text-lg flex items-center space-x-2 hover:bg-white/10 transition-all">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
          <span>{t('heroViewSource')}</span>
        </a>
      </div>

      <!-- App Preview -->
      <div class="relative max-w-5xl mx-auto float">
        <div class="glass rounded-2xl p-2 glow-blue">
          <div class="bg-slate-900 rounded-xl overflow-hidden">
            <!-- Window header -->
            <div class="bg-slate-800 px-4 py-3 flex items-center space-x-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-4 text-sm text-gray-400">BitLoader</span>
            </div>
            <!-- App content mockup -->
            <div class="p-8">
              <div class="grid grid-cols-2 gap-6 mb-6">
                <div class="glass rounded-xl p-4">
                  <div class="text-sm text-gray-400 mb-2">Image File</div>
                  <div class="h-12 bg-slate-800 rounded-lg flex items-center justify-center">
                    <span class="text-gray-500">ubuntu-24.04.iso</span>
                  </div>
                </div>
                <div class="glass rounded-xl p-4">
                  <div class="text-sm text-gray-400 mb-2">USB Device</div>
                  <div class="h-12 bg-slate-800 rounded-lg flex items-center justify-center">
                    <span class="text-gray-500">SanDisk 32GB</span>
                  </div>
                </div>
              </div>
              <!-- Progress bar -->
              <div class="glass rounded-xl p-4">
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-gray-400">Writing...</span>
                  <span class="text-blue-400">75%</span>
                </div>
                <div class="h-3 bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full progress-animate" style="width: 75%"></div>
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-2">
                  <span>2.4 MB/s</span>
                  <span>~2 min remaining</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Decorative elements -->
        <div class="absolute -top-4 -right-4 w-20 h-20 glass rounded-xl flex items-center justify-center sparkle">
          <span class="text-3xl">✨</span>
        </div>
        <div class="absolute -bottom-4 -left-4 w-16 h-16 glass rounded-xl flex items-center justify-center sparkle" style="animation-delay: 0.5s">
          <span class="text-2xl">🚀</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('featuresTitle')}
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          {t('featuresDescription')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {features.map((feature, index) => (
          <div class="feature-card glass rounded-2xl p-8 border border-white/5">
            <div class="text-5xl mb-6">{feature.icon}</div>
            <h3 class="text-xl font-semibold text-white mb-3">{feature.title}</h3>
            <p class="text-gray-400 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-900/10 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          {t('howItWorksTitle')}
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          {t('howItWorksDescription')}
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        {steps.map((step, index) => (
          <div class="relative">
            {index < steps.length - 1 && (
              <div class="hidden md:block absolute top-12 left-1/2 w-full h-0.5 bg-gradient-to-r from-blue-500/50 to-cyan-500/50"></div>
            )}
            <div class="relative text-center">
              <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center glow-blue">
                <span class="text-3xl font-bold text-white">{step.number}</span>
              </div>
              <h3 class="text-xl font-semibold text-white mb-2">{step.title}</h3>
              <p class="text-gray-400">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass rounded-3xl p-12 border border-white/10">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-5xl font-bold text-gradient mb-2">100%</div>
            <div class="text-gray-400">{t('statsOpenSource')}</div>
          </div>
          <div>
            <div class="text-5xl font-bold text-gradient mb-2">{t('statsFree')}</div>
            <div class="text-gray-400">{t('statsFree')}</div>
          </div>
          <div>
            <div class="text-5xl font-bold text-gradient mb-2">{t('statsMacOS')}</div>
            <div class="text-gray-400">{t('statsMacOSVersion')}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Download Section -->
  <section id="download" class="py-32 relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/10 rounded-full blur-3xl"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        {t('downloadTitle')}
      </h2>
      <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
        {t('downloadDescription')}
      </p>

      <div class="glass rounded-3xl p-8 mb-10 border border-white/10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center space-x-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center glow-blue">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-white font-semibold text-lg">{t('downloadName')}</div>
              <div class="text-gray-400 text-sm">{t('downloadVersion')}</div>
            </div>
          </div>
          <a href="https://github.com/yingounet/BitLoader/releases" target="_blank" rel="noopener noreferrer" class="btn-primary px-8 py-4 rounded-full font-semibold text-white text-lg flex items-center space-x-2 whitespace-nowrap">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            <span>{t('downloadButton')}</span>
          </a>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="https://github.com/yingounet/BitLoader" target="_blank" rel="noopener noreferrer" class="flex items-center space-x-2 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
          <span>{t('viewOnGitHub')}</span>
        </a>
        <span class="text-gray-600">•</span>
        <a href="https://github.com/yingounet/BitLoader/issues" target="_blank" rel="noopener noreferrer" class="flex items-center space-x-2 text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{t('reportIssue')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-12 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
            </svg>
          </div>
          <span class="text-lg font-semibold text-white">BitLoader</span>
        </div>

        <div class="flex items-center space-x-8">
          <a href="https://github.com/yingounet/BitLoader" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>

        <div class="text-gray-500 text-sm">
          {t('footerLicense')}
        </div>
      </div>
    </div>
  </footer>

  <!-- Scroll to top script -->
  <script>
    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</div>
